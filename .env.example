# Copiar a .env y rellenar. .env está en .gitignore y nunca se sube.

# --- Base de datos ---------------------------------------------------------
# Credenciales con las que docker-compose crea el contenedor de Postgres.
# POSTGRES_PASSWORD no tiene valor por defecto a propósito: docker compose
# falla si no está definida, en vez de arrancar con una contraseña adivinable.
POSTGRES_USER="inventario"
POSTGRES_PASSWORD=""
POSTGRES_DB="inventario_bbl"
# Puerto en la máquina anfitriona. 5433 y no 5432 a propósito: si hay un
# Postgres instalado en la máquina, se queda con el 5432 y los intentos de
# conexión llegan a él, no al contenedor. El síntoma es un error de contraseña
# ("password authentication failed") sin ni una línea en `docker compose logs`.
POSTGRES_PORT="5433"

# Cadena que usan el servidor, las migraciones y las semillas. Debe concordar
# con las tres variables de arriba y con POSTGRES_PORT.
DATABASE_URL="postgres://inventario:CONTRASENA@localhost:5433/inventario_bbl"

# Base aparte para los tests. Los tests crean y destruyen usuarios y envejecen
# filas del store de sesiones: hacerlo sobre la de desarrollo dejaría basura
# visible en la aplicación si una corrida falla a mitad, y podría cerrar tu
# propia sesión. La crea `npm run test:preparar`; no se le importa el Excel.
DATABASE_URL_TEST="postgres://inventario:CONTRASENA@localhost:5433/inventario_bbl_test"

# --- Sesiones ---------------------------------------------------------------
# Firma las cookies de sesión. Mínimo 32 caracteres.
# En producción es obligatoria: sin ella el servidor se niega a arrancar, porque
# un secreto generado al vuelo invalida todas las sesiones en cada despliegue y
# no coincide entre instancias.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# --- Cifrado ---------------------------------------------------------------
# Clave AES-256-GCM de los campos bios_password y licencia_serial (§5).
# 32 bytes en base64. Generar una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Si se pierde, los valores cifrados en la BD son irrecuperables. Si cambia,
# lo ya cifrado deja de descifrarse: rotarla exige recifrar la tabla.
ENCRYPTION_KEY=""

# --- Admin inicial ----------------------------------------------------------
# La cuenta con la que entrar tras `npm run seed`. §2: sin registro público.
#
# Las tres o ninguna. Vacías, la siembra lo dice y NO crea ninguna cuenta: un
# admin con contraseña por defecto es una puerta trasera que nadie recuerda
# haber abierto. Mismo criterio que POSTGRES_PASSWORD.
#
# Existen porque `npm run db:reset` borra el volumen entero —usuarios incluidos—
# y `npm run usuario` pide la contraseña por stdin, así que no sirve sin un
# humano delante. Ya dejó a alguien fuera de su propia aplicación una vez.
#
# Mínimo 12 caracteres, igual que `npm run usuario`. Sembrar dos veces NO pisa
# la contraseña: si la cuenta ya existe, se deja como está.
ADMIN_EMAIL=""
ADMIN_NOMBRE=""
ADMIN_PASSWORD=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
